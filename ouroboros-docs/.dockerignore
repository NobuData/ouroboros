# Keeps the build context small and secrets out (CONVENTIONS.md § 2). The context is this
# directory alone (see the Dockerfile); the image is built from the committed sources.
.git
node_modules
.yarn/cache
.yarn/install-state.gz
build
.docusaurus
screenshots/test-results
# The capture harness's saved sign-in session — a credential, never image content.
screenshots/.auth
npm-debug.log*
yarn-error.log*
README.md
Dockerfile
.dockerignore
.env*
