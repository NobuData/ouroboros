{
  "name": "ouroboros-docs",
  "version": "0.1.25",
  "private": true,
  "description": "The Ouroboros documentation site — User Guide, Administration and CLI, built with Docusaurus. Not a workspace (CONVENTIONS.md § 1, limit 6).",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "dev": "node scripts/sync-brand.mjs && docusaurus start --port 3100",
    "build": "node scripts/sync-brand.mjs && docusaurus build",
    "serve": "docusaurus serve --port 3100",
    "clear": "docusaurus clear",
    "sync:brand": "node scripts/sync-brand.mjs",
    "check:brand": "node scripts/sync-brand.mjs --check",
    "lint": "eslint . && stylelint \"src/**/*.css\" && markdownlint-cli2",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css}\"",
    "screenshots": "node screenshots/run.ts",
    "check:screenshots": "node screenshots/check.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9",
    "@playwright/test": "^1.62",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@types/jsdom": "^30",
    "@types/node": "^24",
    "@types/react": "^19",
    "ajv": "^8",
    "ajv-formats": "^3",
    "eslint": "^9",
    "globals": "^17",
    "jsdom": "^30",
    "markdownlint-cli2": "^0.23",
    "prettier": "^3",
    "sharp": "^0.34",
    "stylelint": "^17",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
