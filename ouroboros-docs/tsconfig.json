// Not used by `docusaurus start/build`; it serves the editor and `yarn typecheck`.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noEmit": true,
    // screenshots/ runs under Node's own TypeScript support, which needs the extension.
    "allowImportingTsExtensions": true
  },
  "exclude": [".docusaurus", "build", "node_modules"]
}
