// markdownlint-cli2 config for ouroboros-docs (CY.5, #1168) — run by `yarn lint`.
//
// It lints the site's pages (docs/**), which are what readers see; the module README and
// the repository's engineering documents are not part of the site. markdownlint's default
// rules apply, less the ones that do not fit MDX pages:
{
  // Partials (`_*.mdx`) are fragments the pages import, not pages: they have no front matter
  // (Docusaurus rejects it under CI), so the first-heading rule cannot apply, and the one
  // partial that exists is generated and held by tests/config-reference.test.ts.
  "globs": ["docs/**/*.{md,mdx}", "!docs/**/_*.mdx"],
  "config": {
    "default": true,
    // Prose is wrapped by the editor, not at a column, and tables run long.
    "MD013": false,
    // Pages use JSX components (<UiPath>, <SectionCards>, …) — MDX's whole point.
    "MD033": false
  }
}
