# ouroboros-rest — the variables this service reads.
#
# Copy it and edit what you need; the copy is git-ignored, this file is not:
#
#   cp ouroboros-rest/.env.example ouroboros-rest/.env
#
# The copy is read directly — nothing to export. `yarn dev` in this directory, and
# `yarn dev` from the repo root, both pick it up (docs/CONVENTIONS.md § 4, and this
# module's README § Configuration).
#
# Two files are read, in this order, and later wins: the repo-root `.env`, then this one.
# A real environment variable beats both, so a container is still configured by exactly
# what it was started with, and a single run can be overridden without editing anything:
#
#   PORT=4001 yarn dev
#
# The repo-root .env.example is the fuller picture — every OURO_* variable the whole
# system reads, not just this module's — and stays the complete list; this is a subset of
# it, and the values below are identical to the ones there. Where both declare a
# variable, the more specific file wins.
#
# This service does not start on defaults alone: eleven of the variables below have no
# default, because a boundary with no database, no engine, no signing key and no GitHub
# application could serve nothing. A missing one exits 2 naming it, rather than starting
# into a wall of 500s.
#
# Everything here is a local development placeholder and is safe to commit. Nothing here
# is a real credential, and nothing here is suitable for a deployed environment.

# ---------------------------------------------------------------------------
# Listen address
# ---------------------------------------------------------------------------

# HTTP listen port. Unprefixed by convention, because it is what container platforms set
# (docs/CONVENTIONS.md § 4). 4000 is this service's slot in the development port map; the
# UI holds 3000, ouroboros-engine 8000, PostgreSQL 5432.
PORT=4000

# Which environment this is: development, test or production. Unprefixed for the same
# reason as PORT. It decides which interface is bound — every interface in production,
# where the platform routes to the container; loopback everywhere else, so a development
# machine does not answer to the network it is on — and it is what makes the development
# sign-in bypass below unreachable in production.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — ouroboros-db, served by `docker compose up` (see docker-compose.yml)
# ---------------------------------------------------------------------------

# Connection string for the database this service reads and writes. A postgresql:// (or
# postgres://) URL with a host. The five OURO_DB_* variables in the repo-root template
# describe the same database for the compose stack and for ouroboros-db/run.sh; keep this
# consistent with them, because nothing derives it for you.
OURO_DATABASE_URL=postgresql://ouroboros:ouroboros@localhost:5432/ouroboros

# ---------------------------------------------------------------------------
# Service wiring — the URLs each module uses to reach the next one
# ---------------------------------------------------------------------------

# This service's own browser origin. Read for one thing: the GitHub OAuth redirect_uri,
# which has to be the URL registered against the OAuth app rather than whatever Host
# header a request arrived with. An origin — scheme, host and optional port, no path, no
# trailing slash, no wildcard.
OURO_REST_URL=http://localhost:4000

# Where a browser lands after signing in or out. ouroboros-ui's own origin: the OAuth
# callback is a redirect a person follows rather than a fetch a script made, so it has to
# end somewhere with a page on it, and this service serves none.
OURO_UI_URL=http://localhost:3000

# Base URL of ouroboros-engine. The engine is internal and is never reachable from a
# browser — this service is the only thing that calls it.
OURO_ENGINE_URL=http://localhost:8000

# Sent as X-Ouro-Internal-Key on every engine call, and compared there in constant time.
# At least 16 characters. Both sides must carry the same value or the two cannot talk at
# all: ouroboros-engine requires it on every route but liveness.
#
# Generate a strong value, e.g.: openssl rand -base64 32
OURO_ENGINE_SHARED_SECRET=dev-engine-shared-secret-change-me

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# The two variables below are BetterAuth's own, which is why they are the only ones in
# this file without the OURO_ prefix: the library reads these names, its CLI reads these
# names, and so does every page of its documentation (issue #700, roadmap decision A9).

# What BetterAuth signs sessions and encrypts stored OAuth tokens with; at least 16
# characters. Rotating it signs everybody out and makes stored tokens undecryptable.
#
# Generate a strong value, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me

# The origin BetterAuth builds its own URLs from. This service's public address, so the
# same value as OURO_REST_URL above; nothing derives one from the other, so keep them in
# step. An origin — scheme, host and optional port, no path: BetterAuth adds its own
# /api/auth, and a base path written here would appear in the callback URL twice.
BETTER_AUTH_URL=http://localhost:4000

# GitHub OAuth application used for sign-in — BetterAuth's provider reads both (#702).
# Register a development app under Settings -> Developer settings -> OAuth Apps with the
# authorization callback URL http://localhost:4000/api/auth/callback/github and paste its
# credentials here. That URL is ${BETTER_AUTH_URL}/api/auth/callback/github: the library
# builds it from BETTER_AUTH_URL rather than from OURO_REST_URL, and GitHub compares what
# was registered against what the exchange presents, so a difference of one character is a
# sign-in that fails at the last hop.
OURO_GITHUB_CLIENT_ID=dev-github-client-id
OURO_GITHUB_CLIENT_SECRET=dev-github-client-secret

# There is no development sign-in *variable* any more, and that is worth one paragraph
# because the line that used to sit here was the first thing many people edited.
#
# #33 shipped a bypass — one address, and a branch in the guard that treated every request
# as coming from whoever it named. Issue #703 deleted the guard that read it, and issue #705
# deleted the variable along with delivering what replaces it: BetterAuth's email/password
# sign-in, enabled whenever NODE_ENV is not `production` and by nothing else. Signing in
# locally is therefore a real credential against a real `account` row, not a way around the
# check, and there is nothing to set here to turn it on — running outside production is what
# turns it on. See src/auth/password.provider.ts.
#
# The seeded people and their passwords are ouroboros-db's R__dev_seed.sql (issue #709).

# ---------------------------------------------------------------------------
# Credential vault — the envelope-encryption service (issue #222, decision P2)
# ---------------------------------------------------------------------------

# The key-encryption key this service seals every workspace's data-encryption key with.
# Exactly 32 bytes, base64:
#
#   openssl rand -base64 32
#
# Exactly, not at least — which is the one place this variable's rule differs from the
# secrets above, and the difference is what being wrong costs. A signing key that is not
# what the operator meant produces sessions nobody can use, and is fixed by correcting it.
# A key-encryption key that is not what the operator meant produces credential ciphertext
# nobody can ever open, and correcting it afterwards does not help. So a value that is 31
# bytes, or a passphrase somebody typed, is refused at boot rather than stretched to fit:
# the process exits non-zero naming this variable and printing no part of the value.
#
# It encrypts ouroboros.tenant_keys and nothing else. Every provider credential is
# encrypted with a per-workspace key sealed in that table, so moving custody to AWS KMS or
# Vault/OpenBao later (issue #236) is a re-wrap of those rows and leaves every credential
# ciphertext byte-identical. See src/modules/vault/ and this module's README.
#
# LOSING THIS VALUE LOSES EVERY STORED CREDENTIAL. In the default deployment its custody is
# the operator's problem — stated plainly rather than as "KMS-backed", per the honesty rule
# docs/SECURITY_MODEL.md (issue #226) owns.
OURO_VAULT_MASTER_KEY=b3Vyb2Jvcm9zLWRldi12YXVsdC1tYXN0ZXIta2V5ISE=

# Browser origins allowed to call this API with credentials — the origins the session
# cookie is permitted to travel to. Comma-separated, and each entry is an origin rather
# than a URL: a scheme, a host and an optional port, with no trailing slash and no path.
# A wildcard is not accepted, because a credentialed cross-origin request may not be
# answered with one. The development value is ouroboros-ui, the only browser origin there
# is.
OURO_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Dashboard polling — this service's half of the #75 contract
# ---------------------------------------------------------------------------

# Seconds a dashboard client is told to wait between polls — the value sent as
# X-Ouro-Poll-After on every dashboard answer, 200 and 304 alike. The UI's polling hook
# treats the latest value it heard as its effective interval, so raising this is how a
# deployment under load slows every open dashboard within one poll cycle, with nothing
# shipped to the client. Whole seconds, 1–3600; 15 is the visible-tab interval the
# contract documents (docs/ARCHITECTURE.md § 5.4).
OURO_DASHBOARD_POLL_SECONDS=15

# ---------------------------------------------------------------------------
# Bind interface — set only by the e2e stack
# ---------------------------------------------------------------------------

# Which interface this service binds, when a stack has to choose it explicitly. Exactly
# 127.0.0.1 or 0.0.0.0, nothing else. Leave it at the value below: unset (or 127.0.0.1,
# the same posture in development) is what every deployment should inherit — NODE_ENV
# decides the interface on its own, loopback outside production. The one stack that sets
# 0.0.0.0 is the e2e compose override (repo-root docker-compose.e2e.yml, issue #647),
# where the container runs non-production so the seeded password sign-in answers, and
# loopback would be unreachable through Docker's port publishing. The interface is all it
# moves; the sign-in gate stays NODE_ENV's alone (src/auth/password.provider.ts).
OURO_LISTEN_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Local model providers — ouroboros-rest's engine-facing surface
# ---------------------------------------------------------------------------

# Where this deployment's *local* model providers are, as comma-separated kind=url pairs:
#
#   OURO_LOCAL_PROVIDER_URLS=ollama=http://localhost:11434,openai_compatible=http://localhost:8001/v1
#
# Unset by default, and that is the normal posture: most installations run no local model
# server, and a lease for one then answers 404 rather than pretending something is
# listening on a port nobody mentioned.
#
# What it is for. Roadmap decision P3 (issue #224) says workers never hold provider
# credentials: ouroboros-engine asks ouroboros-rest to make every cloud model call and the
# key never leaves the control plane. Local providers are the one exception, because there
# is no key on that path to protect — an engine worker calling an Ollama daemon on the same
# box gains nothing from proxying its traffic — so it asks
# POST /internal/credentials/lease and is told an address. Only an address: a lease has no
# field a credential could arrive in.
#
# Only ollama and openai_compatible may appear here. Naming anthropic, copilot or cursor
# stops the process at boot rather than being ignored, because an operator who wrote it
# believes their workers reach that provider directly, and a service that started anyway
# would leave them believing it. Each address is an absolute http:// or https:// URL and
# keeps its path — vLLM is served at /v1, and an address truncated to its origin sends
# every request to a 404 that reads like the model server being down.
#
# From inside the compose network, "localhost" is the container rather than the machine:
# a daemon running on the host is reachable at host.docker.internal, and one running as a
# service in the stack is reachable by its service name.
#
# Y.1 (issue #189) replaces this with provider_connections rows; until it lands, the
# operator's declaration is the only thing that can say where a local provider is.
#
# The value below is Ollama's own default address, which is what a developer running it
# locally already has. A checkout without Ollama is not broken by it: a lease is an
# address rather than a health check, so the surface answers with this URL and the call
# that follows fails against nothing listening — which is the same thing that happens to
# any other local service that is not up. Delete the line to declare no local providers
# at all.
OURO_LOCAL_PROVIDER_URLS=ollama=http://localhost:11434

# ---------------------------------------------------------------------------
# Testing — this module's integration harness
# ---------------------------------------------------------------------------

# Whether `yarn test:integration` may empty the database between tests.
#
# The harness normally starts a throwaway PostgreSQL of its own, migrates it, and empties
# it between tests; a container it started is disposable by definition and this variable
# is not consulted. It matters only when OURO_DATABASE_URL points the suite at a database
# somebody else started — the compose stack, most likely — because emptying that one takes
# the development seed with it, and no migration puts it back.
#
# So it stays `false` here, and the harness refuses to truncate. Set it to exactly `true`
# for a run against a database you are genuinely willing to lose. Nothing outside the test
# suites reads it.
OURO_TEST_DATABASE_DISPOSABLE=false
