# Module-local artefacts. The repo-root .gitignore covers what any module can produce;
# this file adds what only a Nest/Yarn module emits, so the directory still behaves
# correctly if it is lifted out of the repo (docs/CONVENTIONS.md § 2).

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# compiled output — `nest build` writes here, and `dist/main.js` is what `yarn start`
# and the container (#36) run
/dist

# testing
/coverage

# typescript
*.tsbuildinfo

# env files — real ones never enter git, the documented templates do. The negation is
# load-bearing: `.env*` matches `.env.example` too, so without it this module's template
# would be invisible to git and the file a developer is told to copy would not be there.
.env*
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem
