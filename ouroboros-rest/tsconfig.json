{
  // TypeScript for the communications layer — docs/CONVENTIONS.md § 3 and § 6.
  //
  // This is the configuration `yarn typecheck`, `yarn test` (through ts-jest) and the
  // type-aware ESLint rules all read, so what the editor reports, what CI reports and
  // what the build refuses are the same thing. `tsconfig.build.json` narrows it to the
  // files that ship; nothing else forks it.
  "compilerOptions": {
    // Nest resolves its providers through decorator metadata emitted by the compiler,
    // which CommonJS and these two flags are what produce. `emitDecoratorMetadata` is
    // the load-bearing one: without it every constructor parameter reaches the
    // injector as `Object` and dependency injection stops working at runtime rather
    // than at compile time.
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "jest"],

    // `src` in, `dist` out, stated rather than inferred: the entry point is
    // `dist/main.js` (package.json's `start`, and the container's CMD in #36), and an
    // inferred root directory moves that path the first time a file is added outside
    // src/.
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Strict, as issue #27 asks. The four checks below strict itself are the ones that
    // catch what a scaffold tends to accumulate — a parameter nobody reads, an override
    // that no longer overrides anything, a switch case that falls through by accident.
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
