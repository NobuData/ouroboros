{
  "version": 1,
  "prefix": "/ouro",
  "confirmRule": "Runs only with `confirm` as its last word. Without it nothing happens: the reply describes exactly what would.",
  "commands": [
    {
      "id": "status",
      "aliases": [],
      "usage": "status",
      "syntax": "/ouro status",
      "summary": "everything live, in one line",
      "arguments": [],
      "requires": {
        "roles": [],
        "capability": null,
        "words": "every workspace member"
      },
      "destructive": false,
      "confirmPrompt": null,
      "mode": "sync",
      "stage": "available",
      "unavailableReply": null,
      "binds": "GET /api/v1/dashboard · GET /api/v1/farm · GET /api/v1/inbox"
    },
    {
      "id": "queue",
      "aliases": [],
      "usage": "queue #485 [workflow]",
      "syntax": "/ouro queue <ticket> [workflow]",
      "summary": "send an issue into the loop",
      "arguments": [
        {
          "name": "ticket",
          "type": "ticket",
          "optional": false,
          "description": "the issue to queue — `#485`, `485`, `repo#485` or its GitHub URL",
          "completion": "tickets"
        },
        {
          "name": "workflow",
          "type": "workflow",
          "optional": true,
          "description": "the workflow to pin; left out, the workspace's triggers choose",
          "completion": "workflows"
        }
      ],
      "requires": {
        "roles": [
          "owner",
          "admin",
          "member"
        ],
        "capability": null,
        "words": "workspace owners, admins and members"
      },
      "destructive": false,
      "confirmPrompt": null,
      "mode": "sync",
      "stage": "available",
      "unavailableReply": null,
      "binds": "POST /api/v1/backlog/queue"
    },
    {
      "id": "pause loop",
      "aliases": [],
      "usage": "pause loop 1847",
      "syntax": "/ouro pause loop <loop>",
      "summary": "hold a loop mid-flight",
      "arguments": [
        {
          "name": "loop",
          "type": "loop",
          "optional": false,
          "description": "the loop's number — `1847` or `#1847`",
          "completion": "loops"
        }
      ],
      "requires": {
        "roles": [
          "owner",
          "admin"
        ],
        "capability": null,
        "words": "workspace owners and admins"
      },
      "destructive": false,
      "confirmPrompt": null,
      "mode": "sync",
      "stage": "available",
      "unavailableReply": null,
      "binds": "POST /api/v1/runs/{id}/controls (pause)"
    },
    {
      "id": "resume loop",
      "aliases": [],
      "usage": "resume loop 1847",
      "syntax": "/ouro resume loop <loop>",
      "summary": "let a held loop continue",
      "arguments": [
        {
          "name": "loop",
          "type": "loop",
          "optional": false,
          "description": "the loop's number — `1847` or `#1847`",
          "completion": "loops"
        }
      ],
      "requires": {
        "roles": [
          "owner",
          "admin"
        ],
        "capability": null,
        "words": "workspace owners and admins"
      },
      "destructive": false,
      "confirmPrompt": null,
      "mode": "sync",
      "stage": "available",
      "unavailableReply": null,
      "binds": "POST /api/v1/runs/{id}/controls (resume)"
    },
    {
      "id": "abort loop",
      "aliases": [],
      "usage": "abort loop 1847",
      "syntax": "/ouro abort loop <loop> confirm",
      "summary": "stop and clean up",
      "arguments": [
        {
          "name": "loop",
          "type": "loop",
          "optional": false,
          "description": "the loop's number — `1847` or `#1847`",
          "completion": "loops"
        },
        {
          "name": "confirm",
          "type": "confirm",
          "optional": true,
          "description": "the word `confirm` — without it nothing is aborted",
          "completion": null
        }
      ],
      "requires": {
        "roles": [
          "owner",
          "admin"
        ],
        "capability": null,
        "words": "workspace owners and admins"
      },
      "destructive": true,
      "confirmPrompt": "Add `confirm` to abort — this stops loop {loop} for good and closes its run as canceled. Its branch is kept; nothing is reverted or deleted. `/ouro abort loop {loop} confirm`",
      "mode": "sync",
      "stage": "available",
      "unavailableReply": null,
      "binds": "POST /api/v1/runs/{id}/controls (abort)"
    },
