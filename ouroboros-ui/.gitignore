# Module-local artefacts. The repo-root .gitignore covers what any module can produce;
# this file adds what only a Next.js/Yarn module emits, so the directory still behaves
# correctly if it is lifted out of the repo (docs/CONVENTIONS.md § 2).

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
