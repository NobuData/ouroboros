# Ouroboros — repo-wide ignores.
#
# This file covers artefacts that every module can produce. Module-specific
# ignores (e.g. Next.js's `.next/`) also live in that module's own .gitignore so
# each directory stays self-contained and portable — see docs/CONVENTIONS.md.
#
# Rule of thumb: nothing here may match a file that is already tracked.

# ---------------------------------------------------------------------------
# Secrets & local configuration
# ---------------------------------------------------------------------------
# Real environment files never enter git; the documented templates do.
.env
.env.*
!.env.example
!.env.*.example
*.local
!*.local.example

# Credentials that occasionally land in a module directory by accident.
*.pem
*.key
!*.pub.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Node / TypeScript — ouroboros-ui, ouroboros-rest, ouroboros-web
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Python — ouroboros-engine
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Workspace runner — Turborepo
# ---------------------------------------------------------------------------
# The local task cache and run logs. One at the root and one per package, both written
# by `turbo run`; nothing in either is an input to anything.
.turbo/

# ---------------------------------------------------------------------------
# Build & test output (all toolchains)
# ---------------------------------------------------------------------------
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Database & migrations — ouroboros-db
# ---------------------------------------------------------------------------
# Flyway credentials are supplied by env/compose, never committed. flyway.user.toml is
# the one Flyway loads by itself from the project directory, so it is where a local
# override — and a password — would end up; the committed project is flyway.toml and its
# flyway.dev.toml overlay, which carry no credential at all.
flyway.user.toml
flyway.local.toml
flyway.conf
*.dump
*.sql.gz

# ---------------------------------------------------------------------------
# Editors & operating systems
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Deployment tooling
# ---------------------------------------------------------------------------
.vercel
