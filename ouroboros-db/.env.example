# ouroboros-db — the database run.sh migrates.
#
# Copy it and edit what you need; the copy is git-ignored, this file is not:
#
#   cp ouroboros-db/.env.example ouroboros-db/.env
#
# This file configures one thing: which PostgreSQL `run.sh` connects to. The values
# below point at the database the repo-root `docker compose up` starts, so they work
# unedited. Point them anywhere else — a PostgreSQL installed on this machine, a server
# across the network — and the migrations apply there instead, with nothing
# containerised.
#
# run.sh reads this file first, then the repo-root .env, then these same defaults, and
# anything already in the environment wins over all three. So a one-off run needs no
# file at all:
#
#   OURO_DB_PORT=45432 ouroboros-db/run.sh info
#
# The repo-root .env.example is the fuller picture — every OURO_* variable the whole
# system reads, not just this module's. Values here are local development placeholders
# and are safe to commit.

# Host the database is reachable on. `localhost` covers both a PostgreSQL installed on
# this machine and the compose stack, which publishes on the loopback interface.
OURO_DB_HOST=localhost

# Port it is listening on. The compose stack publishes on OURO_DB_PORT too, so the two
# stay in step; change this if 5432 is already taken by another PostgreSQL.
OURO_DB_PORT=5432

# Database to migrate. It must already exist — Flyway creates the schema, not the
# database.
OURO_DB_NAME=ouroboros

# Role Flyway connects as. It needs rights to create the schema below and everything the
# migrations declare inside it.
OURO_DB_USER=ouroboros

# Password for that role. Local development only; a deployed database takes its
# credentials from the environment, never from a file.
OURO_DB_PASSWORD=ouroboros

# Schema Flyway owns. It is created if absent, and the history table lives inside it, so
# pointing this somewhere else gives you an independent migration history.
OURO_DB_SCHEMA=ouroboros
