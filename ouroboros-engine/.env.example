# ouroboros-engine — the three variables this service reads.
#
# Copy it and edit what you need; the copy is git-ignored, this file is not:
#
#   cp ouroboros-engine/.env.example ouroboros-engine/.env
#
# READ THIS FIRST: the engine loads no dotenv file. Configuration comes from the process
# environment only, so that what a container is started with is exactly what the service
# runs with (docs/CONVENTIONS.md § 4, and this module's README § Configuration). That
# makes this file a template to *export*, not one the service picks up:
#
#   set -a; . ouroboros-engine/.env; set +a    # then a bare `uv run dev` works
#
#   env $(grep -v '^#' ouroboros-engine/.env | xargs) uv run dev    # one-off, no export
#
# `yarn dev` from the repo root needs none of this — turbo reads the repo-root `.env` and
# passes the OURO_* namespace through, so the stack comes up from that file alone.
#
# The repo-root .env.example is the fuller picture — every OURO_* variable the whole
# system reads, not just this module's — and stays the complete list; this is a subset of
# it, and the values below are identical to the ones there. Where both declare a
# variable, the more specific file wins.
#
# Everything here is a local development placeholder and is safe to commit. Nothing here
# is a real credential, and nothing here is suitable for a deployed environment.

# ---------------------------------------------------------------------------
# Listen address
# ---------------------------------------------------------------------------

# HTTP listen port. Unprefixed by convention, because it is what container platforms set
# (docs/CONVENTIONS.md § 4). 8000 is this service's slot in the development port map; the
# UI holds 3000, ouroboros-rest 4000, PostgreSQL 5432.
PORT=8000

# ---------------------------------------------------------------------------
# Authentication — the internal REST-to-engine call
# ---------------------------------------------------------------------------

# Expected value of the X-Ouro-Internal-Key header, compared in constant time. The engine
# is internal and is never reachable from a browser: every route but liveness requires
# this header, so ouroboros-rest must be configured with the same value or the two cannot
# talk at all.
#
# It is MANDATORY and has no default. Unset, the service refuses to start — naming this
# variable — rather than booting and answering a wall of 401s, because a service that
# serves nothing but liveness is a service that looks healthy and does no work.
# 
# Generate a strong value, e.g.: openssl rand -base64 32
OURO_ENGINE_SHARED_SECRET=dev-engine-shared-secret-change-me

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Log verbosity: debug, info, warning or error. Lower-case; anything else is a named
# validation failure at import rather than a surprise on the first request.
OURO_LOG_LEVEL=info
