{
  "auto_merge": {
    "enabled": true,
    "conditions": {
      "all": [
        {
          "effort_lte": "m"
        },
        {
          "not": {
            "label": "refactor"
          }
        }
      ]
    }
  },
  "human_review": {
    "enabled": true,
    "conditions": {
      "any": [
        {
          "label": "refactor"
        },
        {
          "effort_gte": "l"
        }
      ]
    }
  },
  "protected_paths": {
    "enabled": true,
    "conditions": {
      "path_globs": [
        "boot/**",
        "keys/**",
        ".github/**"
      ]
    }
  },
  "dry_run_new_repos": {
    "enabled": true,
    "conditions": {
      "first_n_loops": 10
    }
  }
}
