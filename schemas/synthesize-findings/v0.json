{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouroboros.build/schemas/synthesize-findings/v0.json",
  "title": "Ouroboros synthesize-findings contract, version 0",
  "description": "The request and response of POST /v0/synthesize-findings (#513, BV.4) -- the Build Analyzer's v2 LLM synthesis pass, committed before its implementation (BX.1, #522). The MVP composes suggestions deterministically through typed templates; BX.1 reads the same findings and the composed suggestions and answers with additional suggestion CANDIDATES and ENRICHMENTS of existing ones. The composer validates every candidate exactly as it validates its own: an impact claim carries a computable basis (a formula and the inputs it read) or is explicitly unquantified, in which case the candidate needs a spike. An enrichment adds prose to a composed suggestion and never changes a number. Every candidate and enrichment names its provenance. The root of this document is the response; the request is published beside it under $defs. See fixtures/expected.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates",
    "enrichments",
    "provenance"
  ],
  "properties": {
    "candidates": {
      "description": "Suggestions the composer did not make, proposed for its validation.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "enrichments": {
      "description": "Prose added to composed suggestions -- never a changed number.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/enrichment"
      }
    },
    "provenance": {
      "description": "Who answered. actor none is the unimplemented-by-design stub: no candidates, no enrichments, no model and no cost.",
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {
              "actor": {
                "const": "none"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "maxItems": 0
          },
          "enrichments": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "suggestion_kind": {
      "enum": [
        "build_process",
        "workflow",
        "ticket_draft"
      ]
    },
    "action_binding": {
      "description": "Which plane Apply composes and the change payload (V081, decision A4).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane",
        "change"
      ],
      "properties": {
        "plane": {
          "enum": [
            "farm_config",
            "job_hook",
            "workflow",
            "test_gate",
            "planning"
          ]
        },
        "change": {
          "type": "object"
        }
      }
    },
    "quantified_impact": {
      "description": "An impact with a number: its basis names the formula and every input it read, so the composer can recompute it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "unit",
        "applies_to",
        "basis"
      ],
      "properties": {
        "estimate": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "seconds",
            "interventions",
            "count"
          ]
        },
        "applies_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "description",
            "formula",
            "inputs"
          ],
          "properties": {
            "method": {
              "enum": [
                "measured",
                "extrapolated"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "formula": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "inputs": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      }
    },
    "unquantified_impact": {
      "description": "An impact the basis cannot compute: no number, and the candidate needs a spike.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "unit",
        "applies_to",
        "basis"
      ],
      "properties": {
        "estimate": {
          "type": "null"
        },
        "unit": {
          "enum": [
            "seconds",
            "interventions",
            "count"
          ]
        },
        "applies_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "description"
          ],
          "properties": {
            "method": {
              "const": "unquantified"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "model",
        "cost_cents"
      ],
      "properties": {
        "actor": {
          "enum": [
            "model",
            "none"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "cost_cents": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "candidate": {
      "description": "One proposed suggestion, citing the findings it rests on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "finding_ids",
        "title",
        "evidence_line",
        "impact",
        "needs_spike",
        "action_binding"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/suggestion_kind"
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "impact": {
          "oneOf": [
            {
              "$ref": "#/$defs/quantified_impact"
            },
            {
              "$ref": "#/$defs/unquantified_impact"
            },
            {
              "type": "null"
            }
          ]
        },
        "needs_spike": {
          "type": "boolean"
        },
        "action_binding": {
          "$ref": "#/$defs/action_binding"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "impact": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "const": "unquantified"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "impact"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "needs_spike": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "ticket_draft"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "impact": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "enrichment": {
      "description": "Prose for one composed suggestion, named by its identity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_key",
        "narrative"
      ],
      "properties": {
        "identity_key": {
          "type": "string",
          "pattern": "^[a-z_]+:[0-9a-f]{64}$"
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "finding": {
      "description": "One stored finding (V081), as the composer read it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "analyzer",
        "analyzer_version",
        "finding_type",
        "subject_key",
        "identity_key",
        "data",
        "confidence",
        "confidence_basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "analyzer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "analyzer_version": {
          "type": "integer",
          "minimum": 1
        },
        "finding_type": {
          "type": "string",
          "minLength": 1
        },
        "subject_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "identity_key": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence_basis": {
          "type": "object"
        }
      }
    },
    "composed_suggestion": {
      "description": "One suggestion the deterministic composer already made.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_key",
        "kind",
        "title",
        "evidence_line",
        "confidence",
        "impact",
        "needs_spike",
        "action_binding"
      ],
      "properties": {
        "identity_key": {
          "type": "string",
          "pattern": "^[a-z_]+:[0-9a-f]{64}$"
        },
        "kind": {
          "$ref": "#/$defs/suggestion_kind"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "impact": {
          "type": [
            "object",
            "null"
          ]
        },
        "needs_spike": {
          "type": "boolean"
        },
        "action_binding": {
          "$ref": "#/$defs/action_binding"
        }
      }
    },
    "synthesis_request": {
      "description": "What the composer sends: the run, its window, its findings and what it composed from them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "repo_ref",
        "window",
        "findings",
        "suggestions"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "repo_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "days"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/composed_suggestion"
          }
        }
      }
    }
  }
}
